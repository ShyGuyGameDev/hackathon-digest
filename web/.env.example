# Copy to .env (never commit it). All values are server-side only.
PORT=8787
# Path to the SQLite database file.
DATABASE_PATH=data/hackathons.db
# Long random string that unlocks /admin. Generate with: openssl rand -hex 32
ADMIN_TOKEN=
# Set to 1 to run ingestion inside the server process on an interval.
INGEST_ON_SCHEDULE=1
INGEST_INTERVAL_HOURS=6
# Public origin, used in calendar files and share links.
PUBLIC_ORIGIN=http://localhost:8787
